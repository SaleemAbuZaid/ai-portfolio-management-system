# Apex AI Portfolio Management System - Institutional Connect Template
# Copy this to .env and populate with authorized provider credentials.

PROJECT_NAME="APEX AI Portfolio Management System"
VERSION="2.1.0"
PYTHONPATH=backend

# --- Infrastructure ---
# Local development can use SQLite. Docker Compose overrides DATABASE_URL
# with the PostgreSQL service connection.
DATABASE_URL=sqlite+aiosqlite:///backend/apex_trading.db
REDIS_URL=redis://127.0.0.1:6379/0
POSTGRES_USER=apex_db_user
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_PASSWORD
POSTGRES_DB=apex_db

# --- Institutional News Connectors ---
# Note: Event Registry (NewsAPI.ai) is the authoritative provider for global institutional news.
# Do NOT use newsapi.org keys here.
EVENTREGISTRY_API_KEY=YOUR_EVENT_REGISTRY_KEY
MARKETAUX_API_KEY=YOUR_MARKETAUX_KEY

# --- Institutional Market Data Connectors ---
TWELVEDATA_API_KEY=YOUR_TWELVEDATA_KEY
ALPHAVANTAGE_API_KEY=YOUR_ALPHAVANTAGE_KEY
COINGECKO_API_KEY=YOUR_COINGECKO_KEY
POLYGON_API_KEY=YOUR_POLYGON_KEY

# --- Broker (Alpaca Paper Trading) ---
ALPACA_API_KEY=YOUR_ALPACA_KEY
ALPACA_SECRET_KEY=YOUR_ALPACA_SECRET_KEY
ALPACA_URL=https://paper-api.alpaca.markets
TRADING_MODE=PAPER

# --- Feature Flags & Validation ---
ENABLE_LIVE_MARKET_DATA=True
ENABLE_ENRICHMENT=True
ENABLE_LIVE_NEWS=True
LIVE_VERIFY_MODE=True
STEP12_VALIDATION_MODE=True
ENABLE_NEWS_BACKUP_MODE=True

# --- System Security ---
JWT_SECRET=GENERATE_A_LONG_RANDOM_VALUE_AND_KEEP_IT_PRIVATE
SEED_ADMIN_PASSWORD=
SEED_BROKER_PASSWORD=
SEED_USER_PASSWORD=
STALE_DATA_THRESHOLD_MS=10000
LOG_LEVEL="INFO"
DEBUG=False
